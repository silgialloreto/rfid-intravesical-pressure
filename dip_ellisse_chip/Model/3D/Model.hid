[start]command
'@ transform: rotate component1:incaps
[end]command
[start]content
With Transform 
     .Reset 
     .Name "component1:incaps" 
     .Origin "CommonCenter" 
     .Center "0", "0", "0" 
     .Angle "-1*90", "-1*0", "-1*0" 
     .MultipleObjects "False" 
     .GroupObjects "False" 
     .Repetitions "1" 
     .MultipleSelection "False" 
     .Transform "Shape", "Rotate" 
End With 
[end]content
